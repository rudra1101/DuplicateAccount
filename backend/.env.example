# IdentityAI backend environment example

# Database
# PostgreSQL (recommended for production/local migration):
DATABASE_URL=postgresql+psycopg://identityai:replace-with-password@127.0.0.1:5432/identityai

# Optional SQLAlchemy pool tuning for network databases.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Legacy SQLite fallback:
# Leave DATABASE_URL unset to keep using backend/duplicate_accounts.db.
# IDENTITYAI_DATABASE_PATH can optionally point to a different SQLite file.
# IDENTITYAI_DATABASE_PATH=C:/IdentityAI/duplicate_accounts.db

# SMTP settings used by scheduled executive duplicate reports.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=identityai@example.com
SMTP_PASSWORD=replace-with-secret
SMTP_FROM_EMAIL=identityai@example.com
SMTP_USE_TLS=true
