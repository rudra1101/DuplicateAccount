# IdentityAI deployment template
# deploy.ps1 creates or updates backend/.env automatically.

POSTGRES_DB=identityai
POSTGRES_USER=identityai
POSTGRES_PASSWORD=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=identityai
DATABASE_USER=identityai
DATABASE_PASSWORD=

APP_ENV=deployment
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true

ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ORIGINS=

FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080

# Rudrix uses host Ollama by default when running in Docker Desktop.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Used only with docker-compose.https.yml.
APP_DOMAIN=
